# انسخ الملف ده باسم secrets.toml (محليًا) أو حطه في إعدادات
# Streamlit Community Cloud → Settings → Secrets

GEMINI_API_KEY = "ضع مفتاح Gemini API هنا"

# اختياري - لو مش موجود، المشروع يعمل محليًا بقاعدة SQLite (local_dev.db)
TURSO_DATABASE_URL = "libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN = "ضع التوكن هنا"

# اختياري - لتفعيل البحث على الويب داخل Research Engine
TAVILY_API_KEY = ""
