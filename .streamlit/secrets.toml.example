# ضع القيم الحقيقية في Streamlit Community Cloud > Settings > Secrets
GEMINI_API_KEY = "ضع_مفتاح_Gemini_API_هنا"
GEMINI_MODEL = "gemini-3.7-flash"
GEMINI_TEMPERATURE = "0.75"
GEMINI_MAX_OUTPUT_TOKENS = "16000"

# استخدم HTTP URL من Turso (الأفضل: turso db show <db> --http-url)
# الكود يقبل أيضًا libsql:// ويحوّله تلقائيًا إلى HTTPS.
TURSO_DATABASE_URL = "https://your-db-your-org.turso.io"
TURSO_AUTH_TOKEN = "ضع_Turso_Auth_Token_هنا"

WORKSPACE_ID = "default"
ALLOW_WEB_RESEARCH = "true"
ALLOW_URL_CONTEXT = "true"
