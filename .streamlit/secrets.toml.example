# انسخ الملف ده باسم secrets.toml (جوه نفس مجلد .streamlit) وحط مفتاحك الحقيقي
# لو شغال محلي. لو على Streamlit Community Cloud، حط نفس القيم دي من صفحة
# App settings -> Secrets بدون ما ترفع الملف ده أصلاً.

GEMINI_API_KEY = "ضع_مفتاحك_هنا"

# اختياري: للذاكرة الدائمة اللي بتمنع تكرار نفس الهوكات بين الجلسات.
# لو سبتهم فاضيين أو حذفتهم، التطبيق هيشتغل عادي بس من غير ذاكرة دائمة.
TURSO_DATABASE_URL = "libsql://اسم-قاعدتك.turso.io"
TURSO_AUTH_TOKEN = "التوكن-من-لوحة-تحكم-Turso"
