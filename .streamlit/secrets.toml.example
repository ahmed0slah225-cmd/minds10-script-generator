# .streamlit/secrets.toml.example
# ==================================
# انسخ الملف ده باسم .streamlit/secrets.toml محليًا، أو ضيف نفس القيم
# في "Secrets" من إعدادات التطبيق على Streamlit Community Cloud.
#
# تحذير: ملف secrets.toml الحقيقي (من غير .example) لازم يكون في
# .gitignore ومترفعش على GitHub أبدًا.

GEMINI_API_KEY = "ضيف مفتاحك هنا من Google AI Studio"

# اختياري — لو مش موجودين، المشروع بيشتغل تلقائيًا على SQLite محلي
# TURSO_DATABASE_URL = "libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN = "..."
