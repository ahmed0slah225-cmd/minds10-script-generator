# انسخ الملف ده باسم .env واملأ القيم، أو ضيفهم في Streamlit Secrets وقت النشر.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro

# اختياري — لو مش موجودين، النظام يشتغل تلقائيًا بـ SQLite محلي.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

WEB_SEARCH_ENABLED=false
SEARCH_API_KEY=

LOCAL_SQLITE_PATH=minds10_local.db
APP_ENV=development
